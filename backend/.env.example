# Copy to .env (git-ignored) and fill in. Only these keys are read.
# xAI key for X sentiment (console.x.ai). Leave empty to keep sentiment off.
XAI_API_KEY=
# Hard monthly cap on xAI spend in US dollars (default 10).
XAI_MONTHLY_BUDGET_USD=10
# Optional: model override (default grok-4.7).
XAI_MODEL=
